# Copy this file to .env and adjust values as needed.
# cp .env.example .env   (Mac/Linux)
# copy .env.example .env (Windows)

# Server
APP_NAME=LendWise API
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated frontend origins (no trailing slash)
# Local:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (Render) — replace with your Vercel URL(s):
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Google Gemini (required for PDF extraction)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Supabase (server-side — never expose service role key to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DEFAULT_USER_EMAIL=demo@lendwise.local
